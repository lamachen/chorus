# ── FastVLM ─────────────────────────────────────────────────────────────
# auto = mlx-vlm auf Apple Silicon, sonst transformers, sonst mock
FASTVLM_BACKEND=auto
# leer lassen = automatisch:  mlx-community/FastVLM-0.5B-bf16  bzw.  apple/FastVLM-0.5B
FASTVLM_MODEL=
# größer = schlauer, langsamer. Verfügbare PyTorch-Modelle:
#   apple/FastVLM-0.5B   (~1,6 GB)   apple/FastVLM-1.5B   apple/FastVLM-7B
# MLX-Varianten (Apple Silicon):
#   mlx-community/FastVLM-0.5B-bf16  EZCon/FastVLM-1.5B-4bit-mlx
#   InsightKeeper/FastVLM-0.5B-MLX-4bit
FASTVLM_MODEL_PT=apple/FastVLM-0.5B
FASTVLM_MODEL_MLX=mlx-community/FastVLM-0.5B-bf16
FASTVLM_DEVICE=auto
FASTVLM_DTYPE=auto

# ── Antworten ───────────────────────────────────────────────────────────
MAX_TOKENS=140
TEMPERATURE=0.85
TOP_P=0.92
MAX_HISTORY_TURNS=8

# ── Bild / Gedächtnis (StreamBridge) ────────────────────────────────────
VISION_SHORT_SIDE=768
JPEG_QUALITY=80
MEMORY_FULL_ROUNDS=2
MEMORY_MID_ROUNDS=6
MEMORY_SUMMARY_CHARS=420
MEMORY_BUDGET_CHARS=1400
SCENE_NOTE_MAX_TOKENS=48

# ── Initiative (proaktives Sprechen) ────────────────────────────────────
PROACTIVE=true
ACTIVATION_MODE=hybrid        # off | heuristic | vlm | hybrid
ACTIVATION_INTERVAL=2.5
ACTIVATION_THRESHOLD=0.62
ACTIVATION_COOLDOWN=22.0
ACTIVATION_MIN_LULL=4.0
ACTIVATION_PROBE_EVERY=9.0

# ── Optionales externes Dialog-LLM ──────────────────────────────────────
# none | ollama | openai  (FastVLM bleibt dann das „Auge“, das LLM der „Mund“)
LLM_BACKEND=none
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=
LLM_MAX_TOKENS=220

# ── Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8443
LOG_FRAMES=false
